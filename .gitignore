# Written by `xbr new`. Game data, generated code, the toolchain and the
# bundles never enter git.

# Your dump, and the analysis the pipeline writes beside it; `import`
# builds the dump beside it first and keeps the old one there until the
# new one is in place.
game_files/
game_files.partial/
game_files.old/

# Generated code and its key (`breakdown package` regenerates when it differs).
src/recomp/gen/
src/recomp/gen.key.json
src/recomp/.gen-regenerating

# The pipeline's intermediates.
analysis/

# Builds, and the packaging build trees.
build-win/
build/
build-*/
build-logs/

# `breakdown setup`: the pinned venv, the toolchain, the toolkit and CLI clones.
.venv/
.venv-ghidra/
third_party/
external/
.xbr-pin

# `breakdown package`: private bundles holding the game. Never commit them.
dist/
*.dmg
*.exe
*.pdb
*.nsi
*.tar

# The bench host.
bench-logs/
scripts/bench.env

# Game data, captures and game output, anywhere in the tree.
*.xbe
